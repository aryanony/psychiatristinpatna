# =========================================================================
# SHANTI NEUROPSYCHIATRY CENTRE - CMS & GOOGLE SHEETS ENVIRONMENT CONFIG
# =========================================================================
# 
# 1. GOOGLE APPS SCRIPT WEB APP URL (Recommended)
# Allows reading spreadsheet content dynamically AND writes patient appointment
# bookings directly into the "Appointments" sheet!
# Replace with your deployed Web App URL (ends with /exec):
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# 2. PUBLIC GOOGLE SPREADSHEET ID (Alternative zero-script read-only mode)
# If you only want to read content from a public sheet without deploying Apps Script:
# Example: from https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs/edit
# The ID is the long string between /d/ and /edit:
GOOGLE_SHEET_ID=

# 3. CLINIC WHATSAPP NUMBER FOR APPOINTMENT NOTIFICATIONS
# Country code + number without '+' or hyphens (India is 91 + 10-digit number):
WHATSAPP_NUMBER=917070474808

# 4. CONTENT CACHE DURATION (in minutes)
# How long the browser should cache spreadsheet data before re-fetching (0 = always live):
CMS_CACHE_MINUTES=5
