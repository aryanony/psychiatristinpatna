# Google Apps Script Web App URL
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Public Google Sheet ID (Optional fallback)
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# Clinic WhatsApp Number (e.g. 917070474808)
WHATSAPP_NUMBER=917070474808

# Cache duration in minutes (0 for instant live reload during development)
CMS_CACHE_MINUTES=5
